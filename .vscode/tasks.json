{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[Gradle] Clean Build",
            "type": "gradle",
            "options": {
                "cwd": "${workspaceFolder}"
            },
			"args": "clean build --no-configuration-cache --no-daemon",
            "problemMatcher": []
        },
        {
            "label": "[Gradle] Run",
            "type": "gradle",
            "args": "config.json",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "[Gradle] Clean Build"
        }
    ]
}
