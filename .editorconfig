# Configuration file for EditorConfig
# More information is available under http://EditorConfig.org

# Top-most EditorConfig file. Stops the IDE from looking further up the directory tree.
root = true

# Global rules for all file types
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Java specific formatting overrides
[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8
max_line_length = 120

# IntelliJ IDEA Specific Java formatting (Optional extension)
[*.java]
ij_java_blank_lines_after_imports = 1
ij_java_blank_lines_before_package = 0
ij_java_use_single_class_imports = true
ij_java_doc_comment_leading_asterisks = true

# Build tool definitions and manifest configurations
[*.{xml,gradle,properties}]
indent_size = 2

# Documentation configurations
[*.md]
trim_trailing_whitespace = false
