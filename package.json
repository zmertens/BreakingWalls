{
  "name": "breaking-walls",
  "description": "A Phaser 3 TypeScript game using Vite.",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmertens/BreakingWalls.git"
  },
  "author": "Zach Mertens <zmertens@gmail.com>",
  "license": "MIT",
  "licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
  "bugs": {
    "url": "https://github.com/zmertens/BreakingWalls/issues"
  },
  "homepage": "https://github.com/zmertens/BreakingWalls#readme",
  "scripts": {
    "dev": "node log.js dev & vite --config vite/config.dev.mjs",
    "build": "node log.js build & vite build --config vite/config.prod.mjs",
    "dev-nolog": "vite --config vite/config.dev.mjs",
    "build-nolog": "vite build --config vite/config.prod.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "format": "npm run prettier:fix && npm run lint:fix"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
